# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# Postgres (used by docker-compose AND by the app)
POSTGRES_USER=eduforge
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=eduforge
DATABASE_URL=postgresql+psycopg://eduforge:change-me-strong-password@db:5432/eduforge

REDIS_URL=redis://redis:6379/0

# API keys (one per role). Leave a key empty to disable that role.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
EDITOR_API_KEY=
READER_API_KEY=

# Rate limiting (per API key / client IP)
RATE_LIMIT_BACKEND=redis       # redis | memory
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Outbound fetch policy (SSRF protection, used from Milestone 2 onward)
ALLOW_PRIVATE_NETWORKS=false
MAX_DOWNLOAD_BYTES=26214400
FETCH_TIMEOUT_SECONDS=20

# Document ingestion
STORAGE_DIR=./storage/documents
MAX_UPLOAD_BYTES=26214400

# Optional AI authoring (OpenAI-compatible chat completions endpoint).
# Generated content is always saved as DRAFT and requires admin review.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90

# Optional external educational source discovery (Tavily).
# Search results are unverified leads and never auto-approved.
TAVILY_API_KEY=
RESEARCH_TIMEOUT_SECONDS=30

# Embeddings for semantic search (OpenAI-compatible /embeddings). Schema fixes dimensions at 1536.
# Falls back to LLM_BASE_URL / LLM_API_KEY when empty. Without a key, hybrid retrieval runs without the vector signal.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Knowledge preparation
PREPARE_MAX_EVIDENCE_CHUNKS=8
PREPARE_JOB_MAX_ATTEMPTS=3

# Continuous learning: hard limits on gap-driven external research (requests/cost)
LEARNING_MAX_RESEARCH_PER_SCAN=3
LEARNING_MAX_RESEARCH_PER_DAY=10
LEARNING_MAX_GAPS_PER_SCAN=200
LEARNING_MAX_ASSETS_ASSESSED_PER_SCAN=100

# Document intelligence (worker only; OCR never runs in the API / Vercel)
INGESTION_TEMP_DIR=/tmp/eduforge          # scratch space for downloaded files; cleaned after every job
INGESTION_MAX_PAGES=1500
INGESTION_MAX_CHARS=20000000
INGESTION_SOFT_TIME_LIMIT_SECONDS=1500    # Celery soft limit (job is retried, bounded)
INGESTION_TIME_LIMIT_SECONDS=1620         # Celery hard kill; must exceed the soft limit
INGESTION_MAX_RETRIES=2
INGESTION_LEASE_SECONDS=1800              # crashed-worker recovery window
INGESTION_PENDING_REQUEUE_MINUTES=15
INGESTION_DOCUMENT_BUDGET_SECONDS=1300    # wall-clock budget inside one document (must be below the soft limit)
OCR_ENABLED=true
OCR_LANGUAGES=ara+eng
OCR_DPI=250
OCR_MAX_PAGES_PER_DOCUMENT=400
OCR_PAGE_TIMEOUT_SECONDS=90
OCR_MAX_IMAGE_PIXELS=60000000
PDF_MIN_PAGE_CHARS=25
PDF_MIN_PAGE_QUALITY=0.55
OFFICE_MAX_UNCOMPRESSED_BYTES=209715200
OFFICE_MAX_COMPRESSION_RATIO=100
OFFICE_MAX_MEMBERS=5000
CHUNK_MAX_CHARS=1400
CHUNK_OVERLAP_CHARS=180
EMBED_BATCH_SIZE=32

# Private Supabase Storage (already used by the upload endpoints)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=eduforge-books
