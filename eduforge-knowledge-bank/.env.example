# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# Postgres (used by docker-compose AND by the app)
POSTGRES_USER=eduforge
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=eduforge
DATABASE_URL=postgresql+psycopg://eduforge:change-me-strong-password@db:5432/eduforge

REDIS_URL=redis://redis:6379/0

# API keys (one per role). Leave a key empty to disable that role.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
EDITOR_API_KEY=
READER_API_KEY=

# Rate limiting (per API key / client IP)
RATE_LIMIT_BACKEND=redis       # redis | memory
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Outbound fetch policy (SSRF protection, used from Milestone 2 onward)
ALLOW_PRIVATE_NETWORKS=false
MAX_DOWNLOAD_BYTES=26214400
FETCH_TIMEOUT_SECONDS=20

# Document ingestion
STORAGE_DIR=./storage/documents
MAX_UPLOAD_BYTES=26214400

# Optional AI authoring (OpenAI-compatible chat completions endpoint).
# Generated content is always saved as DRAFT and requires admin review.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90

# Optional external educational source discovery (Tavily).
# Search results are unverified leads and never auto-approved.
TAVILY_API_KEY=
RESEARCH_TIMEOUT_SECONDS=30

# Embeddings for semantic search (OpenAI-compatible /embeddings). Schema fixes dimensions at 1536.
# Falls back to LLM_BASE_URL / LLM_API_KEY when empty. Without a key, hybrid retrieval runs without the vector signal.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Knowledge preparation
PREPARE_MAX_EVIDENCE_CHUNKS=8
PREPARE_JOB_MAX_ATTEMPTS=3

# Continuous learning: hard limits on gap-driven external research (requests/cost)
LEARNING_MAX_RESEARCH_PER_SCAN=3
LEARNING_MAX_RESEARCH_PER_DAY=10
LEARNING_MAX_GAPS_PER_SCAN=200
LEARNING_MAX_ASSETS_ASSESSED_PER_SCAN=100
